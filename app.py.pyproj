<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>4ff52a3c-e102-45f9-90bc-2811b7103d9f</ProjectGuid>
    <ProjectHome>
    </ProjectHome>
    <StartupFile>firma.py</StartupFile>
    <SearchPath>
    </SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>app.py</Name>
    <RootNamespace>firma</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="firma.py" />
    <Compile Include="pbi_push.py">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Content Include=".gitignore" />
    <Content Include="webapp\.gitignore" />
    <Content Include="webapp\package.json" />
    <Content Include="webapp\public\css\style.css" />
    <Content Include="webapp\public\js\main.js" />
    <Content Include="webapp\server.js" />
    <Content Include="webapp\views\automation.html" />
    <Content Include="webapp\views\index.html" />
    <Content Include="webapp\views\kpi.html" />
    <Content Include="webapp\views\overview.html" />
    <Content Include="webapp\views\transactions.html" />
    <Content Include="webapp\views\visualizations.html" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="webapp\" />
    <Folder Include="webapp\views\" />
    <Folder Include="webapp\public\" />
    <Folder Include="webapp\public\css\" />
    <Folder Include="webapp\public\js\" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
